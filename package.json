{
  "name": "martlet",
  "version": "0.2.0",
  "type": "module",
  "description": "Database migration utility in pure js, supporting only .sql files",
  "author": "Eduard Dykman",
  "license": "MIT",
  "bin": {
    "martlet": "cli.js"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./cli": "./cli.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cli.js",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@1.22.19",
  "scripts": {
    "test": "node --test --test-concurrency=1"
  },
  "keywords": [
    "database",
    "migration",
    "sql",
    "postgres"
  ],
  "peerDependencies": {
    "postgres": "^3.4"
  },
  "devDependencies": {
    "postgres": "^3.4.9",
    "testcontainers": "^10.8.1"
  }
}
